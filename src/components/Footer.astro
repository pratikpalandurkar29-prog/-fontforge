---

<footer class="bg-gray-900 text-gray-300">
  <div class="max-w-7xl mx-auto px-6 py-16 lg:py-24">
    <div class="grid grid-cols-2 md:grid-cols-6 gap-8 lg:gap-12 mb-16">
      <!-- Brand -->
      <div class="col-span-2 md:col-span-2 lg:col-span-2">
        <a href="#" class="flex items-center gap-2 text-white font-bold text-xl mb-6">
          <svg class="w-8 h-8" fill="currentColor" viewBox="0 0 32 32">
            <path d="M16 2C8.268 2 2 8.268 2 16s6.268 14 14 14 14-6.268 14-14S23.732 2 16 2zm0 26C10.477 28 6 23.523 6 18S10.477 8 16 8s10 4.477 10 10-4.477 10-10 10zm3.5-14.5c-.828 0-1.5.672-1.5 1.5v7c0 .828.672 1.5 1.5 1.5s1.5-.672 1.5-1.5v-7c0-.828-.672-1.5-1.5-1.5zm-7 0c-.828 0-1.5.672-1.5 1.5v7c0 .828.672 1.5 1.5 1.5s1.5-.672 1.5-1.5v-7c0-.828-.672-1.5-1.5-1.5z"/>
          </svg>
          FontForge
        </a>
        <p class="text-gray-400 text-sm leading-relaxed max-w-xs mb-6">
          The fastest way to identify, extract, and download fonts from any website. Built for designers, developers, and typography enthusiasts.
        </p>
        <div class="flex gap-4">
          {socialLinks.map(social => (
            <a href={social.href} class="text-gray-400 hover:text-white transition-colors" aria-label={social.name} set:html={social.icon}></a>
          ))}
        </div>
      </div>

      <!-- Product Links -->
      <div>
        <h4 class="text-white font-semibold mb-4">Product</h4>
        <ul class="space-y-3" role="list">
          {footerLinks.product.map(link => (
            <li><a href={link.href} class="text-gray-400 hover:text-white text-sm transition-colors">{link.label}</a></li>
          ))}
        </ul>
      </div>

      <!-- Company Links -->
      <div>
        <h4 class="text-white font-semibold mb-4">Company</h4>
        <ul class="space-y-3" role="list">
          {footerLinks.company.map(link => (
            <li><a href={link.href} class="text-gray-400 hover:text-white text-sm transition-colors">{link.label}</a></li>
          ))}
        </ul>
      </div>

      <!-- Resources Links -->
      <div>
        <h4 class="text-white font-semibold mb-4">Resources</h4>
        <ul class="space-y-3" role="list">
          {footerLinks.resources.map(link => (
            <li><a href={link.href} class="text-gray-400 hover:text-white text-sm transition-colors">{link.label}</a></li>
          ))}
        </ul>
      </div>

      <!-- Legal Links -->
      <div>
        <h4 class="text-white font-semibold mb-4">Legal</h4>
        <ul class="space-y-3" role="list">
          {footerLinks.legal.map(link => (
            <li><a href={link.href} class="text-gray-400 hover:text-white text-sm transition-colors">{link.label}</a></li>
          ))}
        </ul>
      </div>
    </div>

    <!-- Bottom Bar -->
    <div class="pt-8 border-t border-gray-800 flex flex-col md:flex-row items-center justify-between gap-4">
      <p class="text-gray-500 text-sm">
        © {new Date().getFullYear()} FontForge. All rights reserved.
      </p>
      <div class="flex items-center gap-6 text-sm text-gray-500">
        <span>Made with <span class="text-red-500">♥</span> for the web</span>
        <span>Powered by Astro + Tailwind</span>
      </div>
    </div>
  </div>
</footer>