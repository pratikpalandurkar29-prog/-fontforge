---
interface Step {
  number: string;
  title: string;
  description: string;
  icon: string;
}

const steps: Step[] = [
  {
    number: "01",
    title: "Enter Website URL",
    description: "Paste any website URL into FontForge. Our system works with any public webpage — from simple blogs to complex web applications.",
    icon: `<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9" /></svg>`
  },
  {
    number: "02",
    title: "AI-Powered Analysis",
    description: "Our advanced detection engine scans the page, analyzing CSS @font-face rules, computed styles, network requests, and font loading APIs to identify every font.",
    icon: `<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" /></svg>`
  },
  {
    number: "03",
    title: "View Detailed Results",
    description: "Get a comprehensive breakdown of each font family including weights, styles, file formats, sizes, foundry information, and licensing details.",
    icon: `<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" /></svg>`
  },
  {
    number: "04",
    title: "Download & Implement",
    description: "Download font files in your preferred format (WOFF2, WOFF, TTF, OTF) and copy ready-to-use CSS @font-face declarations for immediate implementation.",
    icon: `<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" /></svg>`
  }
];
---

<section id="how-it-works" class="py-24 md:py-32 bg-white dark:bg-gray-900">
  <div class="max-w-7xl mx-auto px-6">
    <!-- Section Header -->
    <div class="text-center max-w-3xl mx-auto mb-16">
      <h2 class="text-3xl md:text-4xl lg:text-5xl font-bold text-gray-900 dark:text-white mb-6">
        How It <span class="bg-gradient-to-r from-indigo-600 to-purple-600 bg-clip-text text-transparent">Works</span>
      </h2>
      <p class="text-lg md:text-xl text-gray-600 dark:text-gray-300">
        From URL to font files in four simple steps — no technical expertise required.
      </p>
    </div>

    <!-- Steps -->
    <div class="relative">
      <!-- Connecting line -->
      <div class="hidden lg:block absolute left-1/2 top-0 bottom-0 w-0.5 bg-gradient-to-b from-indigo-500 to-purple-500 -translate-x-1/2"></div>

      <div class="space-y-16 md:space-y-24">
        {steps.map((step, index) => (
          <div class="relative flex flex-col md:flex-row gap-8 items-start md:items-center">
            {index % 2 === 1 && <div class="md:w-1/2 md:order-2" />}

            <!-- Step Number & Icon -->
            <div class="relative z-10 flex-shrink-0 w-20 md:w-24">
              <div class="relative">
                <div class="absolute left-1/2 top-0 bottom-0 w-0.5 bg-gradient-to-b from-indigo-500 to-purple-500 -translate-x-1/2 hidden lg:block"></div>
                <div class="relative flex items-center justify-center w-16 h-16 md:w-20 md:h-20 rounded-2xl bg-gradient-to-br from-indigo-500 to-purple-600 text-white font-bold text-2xl md:text-3xl shadow-lg shadow-indigo-500/25">
                  {step.number}
                </div>
              </div>
            </div>

            <!-- Step Content -->
            <div class="md:w-1/2 {index % 2 === 0 ? 'md:order-2' : 'md:order-1'} text-center md:text-left">
              <div class="inline-flex items-center justify-center w-14 h-14 md:w-16 md:h-16 rounded-xl bg-indigo-100 dark:bg-indigo-900/30 text-indigo-600 dark:text-indigo-400 mb-6" set:html={step.icon}></div>
              <h3 class="text-2xl font-bold text-gray-900 dark:text-white mb-3">
                {step.title}
              </h3>
              <p class="text-gray-600 dark:text-gray-300 leading-relaxed max-w-md mx-auto md:mx-0">
                {step.description}
              </p>
            </div>

            {index % 2 === 0 && <div class="md:w-1/2" />}
          </div>
        ))}
      </div>
    </div>

    <!-- Additional Features Row -->
    <div class="mt-24 grid grid-cols-1 md:grid-cols-3 gap-6">
      {[
        { title: "Batch Processing", desc: "Analyze multiple URLs at once with our bulk analysis feature.", icon: `<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 7v10a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-6l-2-2H5a2 2 0 00-2 2z" /></svg>` },
        { title: "API Access", desc: "Integrate FontForge into your workflow with our REST API and SDKs.", icon: `<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1" /></svg>` },
        { title: "CLI Tool", desc: "Use FontForge from your terminal with our open-source CLI.", icon: `<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 9l3 3-3 3m5 0h3M5 20h14a2 2 0 002-2V6a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" /></svg>` }
      ].map((item, index) => (
        <div class="p-6 rounded-2xl bg-gray-50 dark:bg-gray-800 border border-gray-100 dark:border-gray-700 hover:border-indigo-200 dark:hover:border-indigo-800 transition-all duration-300 group">
          <div class="inline-flex items-center justify-center w-12 h-12 rounded-xl bg-indigo-100 dark:bg-indigo-900/30 text-indigo-600 dark:text-indigo-400 group-hover:bg-indigo-500 group-hover:text-white transition-colors mb-4" set:html={item.icon}></div>
          <h4 class="text-lg font-semibold text-gray-900 dark:text-white mb-2">{item.title}</h4>
          <p class="text-gray-600 dark:text-gray-300 text-sm">{item.desc}</p>
        </div>
      ))}
    </div>
  </div>
</section>